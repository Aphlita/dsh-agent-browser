{
  "name": "dsh-agent-browser",
  "version": "0.3.0",
  "description": "Agent 与用户共用的浏览器：pipe 直连 CDP + 可访问性树快照（含 iframe/STALE_REF 自愈）+ 域名策略与审批 + 右栏像素流 / 内嵌 webview / 原生窗口 + MCP 出口（DSH 插件，Apache-2.0）",
  "type": "module",
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "author": "Aphlita (https://github.com/Aphlita)",
  "homepage": "https://github.com/Aphlita/dsh-agent-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aphlita/dsh-agent-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Aphlita/dsh-agent-browser/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "browser",
    "cdp",
    "agent",
    "computer-use",
    "lease"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "test:unit": "node test/run.mjs --unit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "*"
  }
}